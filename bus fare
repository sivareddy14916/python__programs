import math
def busfare(source,destination):
    Path = [800, 600, 750, 900, 1400, 1200, 1100, 1500]
    BusStops = ["TH", "GA", "IC", "HA", "TE", "LU", "NI", "CA"]
    if source==destination:
        print('Invalid output')
    if source not in BusStops or destination not in BusStops:
        print('Invalid output') 
    fare=0.0    
    s=BusStops.index(source)           
    d=BusStops.index(destination)
    #straight way fare
    if s<d:
        for i in range(s,d):
            fare+=Path[i]
    #circular way fare            
    else:
        for i in range(s,len(BusStops)):
            fare+=Path[i] 

        for i in range(0,d):
            fare+=Path[i]

    return math.ceil((fare*5)/1000 )                      

print(busfare("NI", "HA"))
